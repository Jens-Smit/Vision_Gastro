    <script type="module" src="{{asset('js/home.js')}}"></script>
<script>
  
        //Post Formular verarbeiten
        function sendForm(){
        var formData = {
                user: $('#postUser').val(),
                mail: $('#postMail').val(),
                comments: $('#postComments').val()
            };

            $.ajax({
                type: 'POST',
                url: '/post', // Ersetze dies durch deinen tatsächlichen Endpunkt
                data: formData,
                dataType: 'json',
                success: function(response) {
                    console.log('Erfolgreich:', response);
                    var newPost = `
                                <div class="post">
                                    <p class="post-text">${formData.comments}</p>
                                    <p class="post-info">${formData.user} ${new Date().toLocaleDateString()}</p>
                                </div>
                            `;
                            $('#post').prepend(newPost);

                    // Hier kannst du weitere Aktionen ausführen, z.B. eine Erfolgsmeldung anzeigen
                },
                error: function(xhr, status, error) {
                    console.error('Fehler:', error);
                    // Hier kannst du Fehlerbehandlung durchführen
                }
            });
        }
        function sendCommunetyForm(){
            var formData = {
                
                mail: $('#communetyMail').val(),
                
            };

            $.ajax({
                type: 'POST',
                url: '/community', // Ersetze dies durch deinen tatsächlichen Endpunkt
                data: formData,
                dataType: 'json',
                success: function(response) {
                  document.getElementById('communetyForm').style.display = 'none';

                    // Hier kannst du weitere Aktionen ausführen, z.B. eine Erfolgsmeldung anzeigen
                },
                error: function(xhr, status, error) {
                    console.error('Fehler:', error);
                    // Hier kannst du Fehlerbehandlung durchführen
                }
            });
        }
        
        async function fetchReadme() {
            const url = 'https://raw.githubusercontent.com/Jens-Smit/Vision_Gastro/master/README.md';
            const response = await fetch(url);
            const text = await response.text();
           
            // Extrahiere den Abschnitt "Installation"
            const installationSection = extractSection(text, '## Installation', '## ');

            // Konvertiere den Markdown-Text in HTML
            const html = marked.parse(installationSection, {
                highlight: function (code, lang) {
                    const language = hljs.getLanguage(lang) ? lang : 'plaintext';
                    return hljs.highlight(code, { language }).value;
                }
            });

            document.querySelector('.readme').innerHTML = html;
        }

        function extractSection(text, startMarker, endMarker) {
            const startIndex = text.indexOf(startMarker);
            if (startIndex === -1) return '';

            const endIndex = text.indexOf(endMarker, startIndex + startMarker.length);
            return text.substring(startIndex, endIndex === -1 ? text.length : endIndex);
        }

        fetchReadme();
        document.addEventListener('DOMContentLoaded', async function () {
            await fetchReadme();
            const svgElement = document.querySelector('svg');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        svgElement.querySelectorAll('.date, .name, .pax, .button, .button-text, .checkmark').forEach(el => {
                            el.style.animationPlayState = 'running';
                        });
                        observer.unobserve(svgElement);
                    }
                });
            }, { threshold: 0.1 });
            document.getElementById('postComments').value = '';
            observer.observe(svgElement);
           const preElements = document.querySelectorAll('pre');
            preElements.forEach(function (pre) {
               const button = document.createElement('button');
                button.className = 'copy-button';
                button.innerHTML = '<svg height="800px" width="800px" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 200 200" xml:space="preserve"><g><path style="fill:var(--primery-color);" d="M168.506,0H80.235C67.413,0,56.981,10.432,56.981,23.254v2.854h-15.38 c-12.822,0-23.254,10.432-23.254,23.254v137.492c0,12.822,10.432,23.254,23.254,23.254h88.271 c12.822,0,23.253-10.432,23.253-23.254V184h15.38c12.822,0,23.254-10.432,23.254-23.254V23.254C191.76,10.432,181.328,0,168.506,0z M138.126,186.854c0,4.551-3.703,8.254-8.253,8.254H41.601c-4.551,0-8.254-3.703-8.254-8.254V49.361 c0-4.551,3.703-8.254,8.254-8.254h88.271c4.551,0,8.253,3.703,8.253,8.254V186.854z M176.76,160.746 c0,4.551-3.703,8.254-8.254,8.254h-15.38V49.361c0-12.822-10.432-23.254-23.253-23.254H71.981v-2.854 c0-4.551,3.703-8.254,8.254-8.254h88.271c4.551,0,8.254,3.703,8.254,8.254V160.746z"/></g></svg>';
                pre.appendChild(button);
                button.addEventListener('click', function () {
                   const code = pre.querySelector('code').innerText;
                   const tempTextArea = document.createElement('textarea');
                    tempTextArea.value = code;
                    document.body.appendChild(tempTextArea);
                    tempTextArea.select();
                    document.execCommand('copy');
                    document.body.removeChild(tempTextArea);
                    console.log('Code Kopiert');
                    let tooltip = document.createElement('div');
                    tooltip.className = 'tooltip';
                    tooltip.innerText = 'Code Kopiert';
                    document.body.appendChild(tooltip);
                    // Tooltip an Cursor-Position setzen
                    tooltip.style.left = event.pageX + 'px';
                    tooltip.style.top = event.pageY + 'px';
                    // Tooltip nach 3 Sekunden entfernen
                    setTimeout(function () {
                        document.body.removeChild(tooltip);
                    }, 2000);
                

                });
            });
            const sendMail = document.getElementById('communetyForm')
            sendMail.addEventListener("submit", function (event) {
                event.preventDefault();
                sendCommunetyForm()
                
            });
        });
        
    </script>
