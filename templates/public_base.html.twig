<!DOCTYPE html>
<html lang="de">
<head>
 <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="keywords" content="Gastro 2.0, Vision Gastro, Gamasy, Gästemanagement, Mitarbeiterverwaltung, Reservierungen, Hotellerie, Gastronomie, kostenlose Software, webbasierte Lösung">
  <meta name="description" content="Gamasy ist ein kostenloses Tool für Restaurants, das ein Reservierungssystem und eine Gästeverwaltung bietet. Mit unserer webbasierten Softwarelösung können Sie Mitarbeiter, Gäste und Reservierungen in der Hotellerie und Gastronomie verwalten. Optimieren Sie Ihre Betriebsabläufe und steigern Sie die Effizienz mit Gamasy. Jetzt kostenlos anmelden und loslegen.Gamasy ist ein kostenloses Tool für Restaurants, das ein Reservierungssystem und eine Gästeverwaltung bietet. Mit unserer webbasierten Softwarelösung können Sie Mitarbeiter, Gäste und Reservierungen in der Hotellerie und Gastronomie verwalten. Optimieren Sie Ihre Betriebsabläufe und steigern Sie die Effizienz mit Gamasy. Jetzt kostenlos anmelden und loslegen.">
  <link rel="canonical" href="https://www.gamasy.de/">   
  <meta name="robots" content="index, follow"> 
  <title>{% block title %}Gamasy - Free Tool für Restaurants mit Reservierungssystem und Gästeverwaltung{% endblock %}</title>
  
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
  <link rel="stylesheet" href="{{asset('css/bootstrap.min.css')}}">
  <link rel="stylesheet" href="{{asset('css/all.min.css')}}">
  <link rel="stylesheet" href="{{asset('css/css.css')}}">
 

 <style>
#sidebar.sidebar-collapsed {
  width: 40px;
}

#sidebar.sidebar-collapsed .nav-item a {
  
  width: 40px;
}



</style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-light bg-light">
    <a class="navbar-brand" style='width: 80px;' href="{{path('home')}}">
     <svg viewBox="0 0 800 800" xmlns="http://www.w3.org/2000/svg">
           <!-- <animateTransform begin="5" attributeName="transform" type="scale" values="1; 0.1" keyTimes="0;1" dur="2s" repeatCount="1" fill="freeze"/> -->
           <g id="svg-glow-background">
               <rect width="500" height="500" x="175" y="175" rx="20" ry="20" fill="#00ffff"
                   style="filter: blur(60px); opacity: 0; z-index: -2; position: relative;">
                   <animateTransform begin="2s" attributeName="transform" type="translate"
                       values="0,0; 30,-30; 30,30; -20,30; 00,00" keyTimes="0;0.25;0.5;0.75;1" dur="8s"
                       repeatCount="indefinite" />
                   <animateTransform begin="2s" attributeName="transform" type="scale" values="1; 0.6; 0.8; 0.9; 1"
                       keyTimes="0;0.25;0.5;0.75;1" dur="6s" repeatCount="indefinite" additive="sum" />
                   <animate attributeName="opacity" begin="2s" values="0.5; 0.2; 0.7; 0.2; 0.5"
                       keyTimes="0;0.25;0.5;0.75;1" dur="9s" repeatCount="indefinite" />
               </rect>
               <rect width="500" height="500" x="175" y="175" rx="20" ry="20" fill="#ff0072"
                   style="filter: blur(60px); opacity: 0; z-index: -2; position: relative;">
                   <animateTransform begin="2s" attributeName="transform" type="translate"
                       values="30,30; -20,20; 00,0; 30,-30; 30,30" keyTimes="0;0.25;0.5;0.75;1" dur="8s"
                       repeatCount="indefinite" />
                   <animateTransform begin="2s" attributeName="transform" type="scale"
                       values="0.8; 0.9; 1; 0.7; 0.8" keyTimes="0;0.25;0.5;0.75;1" dur="6s"
                       repeatCount="indefinite" additive="sum" />
                   <animate attributeName="opacity" begin="2s" values="0.6; 0.5; 0.2; 0.5; 0.6"
                       keyTimes="0;0.25;0.5;0.75;1" dur="9s" repeatCount="indefinite" />
               </rect>
           </g>
           <g>
               
               <defs>
                   <filter id="shadow" x="-50%" y="-50%" width="200%" height="200%">
                       <feDropShadow dx="10" dy="10" stdDeviation="10" flood-color="rgba(155, 100, 200, 0.5)" />
                   </filter>
               </defs>
               <g id="svg-cube-v">
                  
                   <path d="M 200 200 l 0 299 l 199 0 l 0 -200 l 200 0 l 0 -100 l -400 0" fill="#ffffff"
                       stroke-width="5" filter="url(#shadow)" stroke="transparent" />
                   <text x="210" y="425" fill="#ff0072" font-family="Arial" font-weight="900" font-size="250"
                       opacity="1">
                       V
                       
                   </text>
               </g>
               <g transform="rotate(-180, 100, 100) translate(-400,-400)" id="svg-cube-g">
                   
                   <path d="M 0 0 l 0 299 l 199 0 l 0 -200 l 200 0 l 0 -100 l -400 0" fill="#00ffff"
                       stroke-width="5" stroke="transparent" filter="url(#shadow)" />
                   <text x="210" y="425" fill="#ffffff" font-family="Arial" font-weight="900" font-size="250"
                       transform="rotate(180, 100, 100) translate(-215,-250)" opacity="0">
                       G
                       <animate attributeName="opacity" from="0" to="1" begin="2s" dur="2s" fill="freeze" />
                   </text>
               </g>
           </g>
       </svg>
    
    </a>
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav">
        <li class="nav-item active">
          <a class="nav-link" style='font-size: 1.5rem;font-weight: 700;' href="{{path('home')}}">Home</a>
        </li>
        
      </ul>
    </div>
    <ul class="navbar-nav ml-auto">
      <li class="nav-item dropdown">
      {% if is_granted('IS_AUTHENTICATED_FULLY')  %}
        <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
          {{ app.user.vorname }}
        </a>
        <div class="dropdown-menu" style="position: absolute;    margin: 0px 0px 0px -100px" aria-labelledby="userDropdown">
          
          <a class="dropdown-item" href="{{path('app_logout')}}">Logout</a>
          <a class="dropdown-item" href="{{path('app_user_index')}}">Settings</a>
          <a class="dropdown-item" href="{{path('reg')}}">Registrieren</a>
        </div>
          
        {% else %}
       
        <!-- alt -->
        
        {% endif %}
      </li>
    </ul>
  </nav>

  
  <!-- Page -->
  <div class="container-fluid">
          <!-- Content -->
      <div class="container">
       
      {% for type, messages in app.session.flashbag.all %}
    {% for message in messages %}
        <div class="alert alert-{{ type }}">{{ message|trans }}</div>
    {% endfor %}
{% endfor %}
         {% block body %}{% endblock %}
      </div>
  </div>
  
  <!-- Footer -->
  <footer class="bg-light py-3 mt-5">
    <div class="container">
      <p>Copyright &copy; VisionGastro</p>
    </div>
  </footer>
  
 <!-- 
 <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
 
 <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js" integrity="sha384-B4gt1jrGC7Jh4AgTPSdUtOBvfO8shuf57BaghqFfPlYxofvL8/KUEfYiJOMMV+rV" crossorigin="anonymous"></script>
 -->
 <script src="{{asset('js/jquery-3.5.1.slim.min.js')}}"></script>

	<script src="{{asset('js/bootstrap.min.js')}}"></script>
   
	
<script>
$(document).ready(function() {
$('#sidebar').addClass('sidebar-collapsed');
 $(".link_text").hide();
 
  $('#sidebar_toggle').click(function() {
  
    if($('#sidebar').hasClass('sidebar-collapsed')) {
      $('#sidebar').removeClass('sidebar-collapsed');
	  $(".link_text").show();
	  $("#silebar_icon").removeClass('fa-chevron-right').addClass('fa-chevron-left');
    } else {
      $('#sidebar').addClass('sidebar-collapsed');
	  $(".link_text").hide();
	  $("#silebar_icon").removeClass('fa-chevron-left').addClass('fa fa-chevron-right');
    }
  });
});

</script>
</body>
</html>


