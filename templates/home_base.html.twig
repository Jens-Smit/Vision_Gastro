
<html lang="de">
<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="keywords" content="Gastro 2.0, Vision Gastro, Gamasy, Gästemanagement, Mitarbeiterverwaltung, Reservierungen, Hotellerie, Gastronomie, kostenlose Software, webbasierte Lösung">
  <meta name="description" content="Gamasy ist eine kostenlose webbasierte Softwarelösung für die Verwaltung von Mitarbeitern, Gästen und Reservierungen in der Hotellerie und Gastronomie. Optimiere deine Betriebsabläufe und steigere die Effizienz mit Gamasy. Jetzt kostenlos anmelden und loslegen.">
  <link rel="canonical" href="https://www.gamasy.de/">   
  <meta name="robots" content="index, follow"> 
  <title>{% block title %}Vision Gastro  - Kostenlose webbasierte Softwarelösung für Gästemanagement, Mitarbeiterverwaltung und Reservierungen in der Hotellerie und Gastronomie{% endblock %}</title>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
	<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-WPSV57MWXZ"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-WPSV57MWXZ');
</script>
		{% block stylesheets %}
      {{ encore_entry_link_tags('app') }}
			<link rel="stylesheet" href="{{asset('css/home_style.css')}}">
    {% endblock %}
</head>
<body>

  <header>
   <div id="logo">
       <svg viewBox="0 0 800 800" xmlns="http://www.w3.org/2000/svg">
           <!-- <animateTransform begin="5" attributeName="transform" type="scale" values="1; 0.1" keyTimes="0;1" dur="2s" repeatCount="1" fill="freeze"/> -->
           <g id="svg-glow-background">
               <rect width="500" height="500" x="175" y="175" rx="20" ry="20" fill="#00ffff"
                   style="filter: blur(60px); opacity: 0; z-index: -2; position: relative;">
                   <animateTransform begin="2s" attributeName="transform" type="translate"
                       values="0,0; 30,-30; 30,30; -20,30; 00,00" keyTimes="0;0.25;0.5;0.75;1" dur="8s"
                       repeatCount="indefinite" />
                   <animateTransform begin="2s" attributeName="transform" type="scale" values="1; 0.6; 0.8; 0.9; 1"
                       keyTimes="0;0.25;0.5;0.75;1" dur="6s" repeatCount="indefinite" additive="sum" />
                   <animate attributeName="opacity" begin="2s" values="0.5; 0.2; 0.7; 0.2; 0.5"
                       keyTimes="0;0.25;0.5;0.75;1" dur="9s" repeatCount="indefinite" />
               </rect>
               <rect width="500" height="500" x="175" y="175" rx="20" ry="20" fill="#ff0072"
                   style="filter: blur(60px); opacity: 0; z-index: -2; position: relative;">
                   <animateTransform begin="2s" attributeName="transform" type="translate"
                       values="30,30; -20,20; 00,0; 30,-30; 30,30" keyTimes="0;0.25;0.5;0.75;1" dur="8s"
                       repeatCount="indefinite" />
                   <animateTransform begin="2s" attributeName="transform" type="scale"
                       values="0.8; 0.9; 1; 0.7; 0.8" keyTimes="0;0.25;0.5;0.75;1" dur="6s"
                       repeatCount="indefinite" additive="sum" />
                   <animate attributeName="opacity" begin="2s" values="0.6; 0.5; 0.2; 0.5; 0.6"
                       keyTimes="0;0.25;0.5;0.75;1" dur="9s" repeatCount="indefinite" />
               </rect>
           </g>
           <g>
               <animateTransform begin="5s" attributeName="transform" type="rotate"
                   values=" 360 400 400; 720  400 400; 1440 400 400" keyTimes="0;0.5;1" dur="1s" repeatCount="1"
                   additive="sum" />
               <defs>
                   <filter id="shadow" x="-50%" y="-50%" width="200%" height="200%">
                       <feDropShadow dx="10" dy="10" stdDeviation="10" flood-color="rgba(155, 100, 200, 0.5)" />
                   </filter>
               </defs>
               <g id="svg-cube-v">
                   <animateTransform attributeName="transform" type="translate" values="-300,-300; 0,0"
                       keyTimes="0;1" dur="2s" repeatCount="1" />
                   <animateTransform attributeName="transform" type="rotate" values=" 360  200 200; 0 200 200"
                       keyTimes="0;1" dur="2s" repeatCount="1" additive="sum" />
                   <animateTransform begin="1.5s" attributeName="transform" type="scale" values="1; 1.1; 1"
                       keyTimes="0;0.5;1" dur=".5s" repeatCount="1" additive="sum" />
                   <path d="M 200 200 l 0 299 l 199 0 l 0 -200 l 200 0 l 0 -100 l -400 0" fill="#ffffff"
                       stroke-width="5" filter="url(#shadow)" stroke="transparent" />
                   <text x="210" y="425" fill="#ff0072" font-family="Arial" font-weight="900" font-size="250"
                       opacity="0">
                       V
                       <animate attributeName="opacity" from="0" to="1" begin="2s" dur="2s" fill="freeze" />
                   </text>
               </g>
               <g transform="rotate(-180, 100, 100) translate(-400,-400)" id="svg-cube-g">
                   <animateTransform attributeName="transform" type="translate" values="800,800; 400,400"
                       keyTimes="0;1" dur="2s" repeatCount="1" />
                   <animateTransform attributeName="transform" type="rotate" values=" 180  100 100 ;-180 100 100"
                       keyTimes="0;1" dur="2s" repeatCount="1" additive="sum" />
                   <animateTransform begin="1.5s" attributeName="transform" type="scale" values="1; 1.1; 1"
                       keyTimes="0;0.5;1" dur="0.5s" repeatCount="1" additive="sum" />
                   <path d="M 0 0 l 0 299 l 199 0 l 0 -200 l 200 0 l 0 -100 l -400 0" fill="#00ffff"
                       stroke-width="5" stroke="transparent" filter="url(#shadow)" />
                   <text x="210" y="425" fill="#ffffff" font-family="Arial" font-weight="900" font-size="250"
                       transform="rotate(180, 100, 100) translate(-215,-250)" opacity="0">
                       G
                       <animate attributeName="opacity" from="0" to="1" begin="2s" dur="2s" fill="freeze" />
                   </text>
               </g>
           </g>
       </svg>
    
   </div>
   <nav id="navi">
       <ul>
           <li><a href="#vision">Vision</a></li>
           <li><a href="#os">Open Sorce</a></li>
           <li><a href="#contact">Support us</a></li>
       </ul>
   </nav>
   <div id="menuIcon">
       <p></p>
       <p></p>
       <p></p>
   </div>
  </header>
		{% block body %}{% endblock %}
    <div id="cookie-banner" style="position: fixed; bottom: 0; width: 100%; background: #333; color: #fff; padding: 10px; text-align: center;">
    Diese Website verwendet Cookies, um Ihnen das beste Erlebnis auf unserer Website zu bieten. <button id="accept-cookies" style="background: #4CAF50; color: white; border: none; padding: 5px 10px; cursor: pointer;">Akzeptieren</button>
  </div>
  <script>
    document.getElementById('accept-cookies').addEventListener('click', function() {
      document.getElementById('cookie-banner').style.display = 'none';
      document.cookie = "cookies_accepted=true; path=/; max-age=" + (60*60*24*365);
      gtag('config', 'G-Z430ZX8TVN', { 'anonymize_ip': true });
    });
  </script>
		  <footer>
        <div class="SozialmediaIcons">

        </div>
        <div class="footer-links">
           
            <a href="/privacy">Datenschutz</a>
        </div>
        <div class="copyright">
            <p>&copy; 2024 Vision-Gastro. Alle Rechte vorbehalten.</p>
        </div>
    </footer>
    
	{% block javascripts %}
		<script src="{{asset('js/jquery-3.6.3.min.js')}}"></script>	
    <script type="importmap">
        {
          "imports": {
            "three": "./js/three.module.js"
          }
        }
    </script>
    
    <script>
        const menuIcon = document.getElementById('menuIcon');
        const navi = document.getElementById('navi');
        menuIcon.addEventListener('click', function () {
            this.classList.toggle('active');
            navi.classList.toggle('openNavi')
            navi.classList.toggle('milchglas')
        });
        </script>
		{{ encore_entry_script_tags('app') }}
        {% endblock %}
</body>
</html>


